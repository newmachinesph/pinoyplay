# Copy to .env.local and fill in. All values are server-only (never prefixed NEXT_PUBLIC_).

# MySQL from `docker compose up -d` (compose.yaml). Without it the game still
# plays and keeps scores on the device; the leaderboard API answers 503.
DATABASE_URL=mysql://pinoyplay:localdev@127.0.0.1:3306/pinoyplay

# Reviews usernames before they appear on the public leaderboard.
# Without a key, names stay pending and show as "Kalaro #1234".
OPENAI_API_KEY=
# Optional: model used for the username review.
OPENAI_NAME_MODEL=gpt-6-luna
